# ==============================================================================
# INFRONIXWEB & FOUNDER OS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual production/local credentials.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# --- APPLICATION SITE CONFIGURATION ---
# Base site URL for emails & verification links (defaults to https://infronixweb.in)
APP_BASE_URL="https://infronixweb.in"

# --- DATABASE CONFIGURATION ---
# PostgreSQL / Supabase connection URL
SUPABASE_DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres"

# --- ADMIN AUTHENTICATION ---
JWT_SECRET="replace_with_a_secure_random_32_char_hex_secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace_with_secure_admin_password"

# --- HOSTINGER SMTP EMAIL AUTOMATION ---
# Primary Hostinger SMTP Configuration (Recommended: Port 465 SSL)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="support@infronixweb.in"
SMTP_PASSWORD="Madhav@#&142009"
SMTP_FROM_EMAIL="support@infronixweb.in"
SMTP_FROM_NAME="InfronixWeb"

# Primary Admin notification recipient for new client submissions
ADMIN_NOTIFICATION_EMAIL="madhavdavda2009@gmail.com"

# Fallback SMTP Settings (If Port 465 is blocked by network / cloud host):
# SMTP_PORT=587
# SMTP_SECURE=false

# Legacy / Alternative Hostinger Mail API SDK (Optional)
# HOSTINGER_EMAIL="notifications@infronixweb.in"
# HOSTINGER_EMAIL_PASSWORD="replace_with_hostinger_mailbox_password"
# HOSTINGER_API_TOKEN=""
